# ============ KEEP THESE FILES ============
# (Using ! to negate ignore)

# Keep README
!README.md

# Keep Gradle Wrapper
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Keep ProGuard Rules
!proguard-rules.pro
!app/proguard-rules.pro

# Keep Firebase Config Templates (without secrets)
!firebase.json
!firestore.indexes.json
!firestore-security-rules.rules
!firebase-storage-rules.rules

# Keep CMakeLists for native build
!**/CMakeLists.txt

# Keep package.json for Firebase Functions
!functions/package.json
!functions/index.js
