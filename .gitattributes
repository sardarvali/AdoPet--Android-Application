# ================================
# Git Attributes for Android Project
# ================================

# Auto detect text files and perform LF normalization
* text=auto

# ============ SOURCE CODE ============

# Java sources
*.java text diff=java

# Kotlin sources
*.kt text diff=kotlin
*.kts text diff=kotlin

# XML files
*.xml text

# JSON files
*.json text

# Markdown files
*.md text

# YAML files
*.yaml text
*.yml text

# ============ GRADLE ============

# Gradle
*.gradle text
*.gradle.kts text
gradlew text eol=lf
gradle-wrapper.properties text

# ============ PROPERTIES ============

*.properties text

# ============ SCRIPTS ============

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============ DOCUMENTATION ============

*.txt text
README text
LICENSE text
AUTHORS text
CHANGELOG text

# ============ CONFIGURATION ============

*.conf text
*.config text
*.ini text
.editorconfig text
.gitignore text
.gitattributes text

# ============ WEB FILES ============

*.html text diff=html
*.css text diff=css
*.js text
*.jsx text
*.ts text
*.tsx text

# ============ DATA FILES ============

*.csv text
*.tsv text
*.sql text

# ============ BINARY FILES ============

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary

# Audio/Video
*.mp3 binary
*.mp4 binary
*.wav binary
*.avi binary
*.mov binary

# Archives
*.zip binary
*.jar binary
*.aar binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Android
*.apk binary
*.aab binary
*.dex binary
*.class binary

# Native libraries
*.so binary
*.dll binary
*.dylib binary
*.jnilib binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Keystore
*.jks binary
*.keystore binary

# ============ MERGE STRATEGIES ============

# Automatically resolve merge conflicts for generated files
*.pbxproj merge=union

# Use ours strategy for these files in merge conflicts
# (comment out if you want to manually resolve)
# gradle/wrapper/gradle-wrapper.properties merge=ours
# app/build.gradle.kts merge=ours

# ============ DIFF HANDLING ============

# Use linguist for better language detection on GitHub
*.gradle linguist-language=Gradle
*.gradle.kts linguist-language=Kotlin

# Mark generated files
app/build/** linguist-generated=true
build/** linguist-generated=true
.gradle/** linguist-generated=true

# ============ EXPORT IGNORE ============

# Files to exclude from export-ignore (git archive)
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.idea export-ignore
*.bat export-ignore
*.sh export-ignore
test/** export-ignore
tests/** export-ignore

