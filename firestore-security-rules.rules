rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function - Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin function to check if user is admin
    // Checks both isAdmin and admin fields for compatibility
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true);
    }

    // Check if user owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection - users can read/write their own data, admins can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated();
    }

    // Pets collection - all authenticated users can read, only admins can write
    match /pets/{petId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && isAdmin();
    }

    // Adoption requests - users can create and read their own, admins can read/write all
    match /adoption_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // Adoptions collection
    match /adoptions/{adoptionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // Rescue requests - users can create and read their own, admins can read/write all
    match /rescue_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // Contact messages - users can create and read their own, admins can read/write all
    match /contact_messages/{messageId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // Tips - all authenticated users can read, only admins can write
    match /tips/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // Success stories - all can read, only admins can write
    match /success_stories/{storyId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }

    // Office details - all can read, only admins can write
    match /office_details/{detailId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }

    // Admin notifications - only admins can read/write
    match /admin_notifications/{notificationId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // User notifications - users can read their own, admins can read/write all
    match /user_notifications/{notificationId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notifications collection (general) - authenticated users can create and read their own
    match /notifications/{notificationId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Debug test collection - for development and testing
    match /debug_test/{docId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // Security logs - only admins can read/write
    match /security_logs/{logId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // App config - all can read, only admins can write
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }

    // Shelters collection - all authenticated users can read, only admins can write
    match /shelters/{shelterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && isAdmin();
    }

    // Shelter requests - users can create and read their own, admins can read/write all
    match /shelter_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // Admin actions - only admins can read/write
    match /admin_actions/{actionId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // Admin history
    match /admin_history/{historyId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // Conversations - users can read/write their own conversations, admins can access all
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid in resource.data.participants || isAdmin());
      allow write: if isAuthenticated() &&
        (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated();
    }

    // Messages within conversations - users can read/write in their conversations
    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Pet health records
    match /pet_health/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
    }

    // Analytics (read-only for regular users, read-write for admins)
    match /analytics/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // Catch-all for any other collections (deny by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

