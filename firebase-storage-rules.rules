rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to validate image file type
    function isValidImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Helper function to check file size (max 10MB)
    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Allow read access to all users for pet images and public content
    match /pets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        isValidImage() &&
        isValidSize() &&
        (request.auth.uid != null || isAdmin());
    }

    // User profile images - users can only access their own
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        isValidImage() &&
        isValidSize() &&
        (request.auth.uid == userId || isAdmin());
    }

    // Rescue request images
    match /rescue_requests/{userId}/{allPaths=**} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        isValidImage() &&
        isValidSize();
    }

    // Contact message attachments
    match /contact_attachments/{allPaths=**} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null &&
        isValidImage() &&
        isValidSize();
    }

    // Success stories - admin can write, all can read
    match /success_stories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        isAdmin() &&
        isValidImage() &&
        isValidSize();
    }
  }
}
