<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Pet Adoption App
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Include app data by default -->
    <include domain="file" path="." />

    <!-- Include SharedPreferences first, then exclude sensitive ones -->
    <include domain="sharedpref" path="." />

    <!-- Exclude sensitive data from backups -->
    <!-- Exclude SharedPreferences that may contain tokens or sensitive data -->
    <exclude domain="sharedpref" path="firebase_auth_cache.xml" />
    <exclude domain="sharedpref" path="com.google.firebase.auth.internal.HeartBeatStore.xml" />
    <exclude domain="sharedpref" path="api_key_cache.xml" />

    <!-- Exclude database files (if they contain sensitive data) -->
    <!-- Uncomment if you add Room database with sensitive data -->
    <!-- <exclude domain="database" path="pet_adoption_db" /> -->
</full-backup-content>