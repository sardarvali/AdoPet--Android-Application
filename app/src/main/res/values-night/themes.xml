<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Dark Mode -->
    <style name="Base.Theme.P3" parent="Theme.Material3.DayNight">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/primary_dark_mode</item>
        <item name="colorPrimaryVariant">@color/primary_variant_dark_mode</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:textColorHint">@color/text_hint_dark</item>
        <item name="elevationOverlayEnabled">true</item>
        <item name="cardViewStyle">@style/CardViewStyle</item>
    </style>

    <!-- Card Styles - Dark Mode -->
    <style name="CardViewStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeColor">@color/card_stroke_dark</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Button Styles - Dark Mode -->
    <style name="ButtonPrimary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_dark_mode</item>
        <item name="android:textColor">@color/black</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="ButtonSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_dark_mode</item>
        <item name="android:textColor">@color/primary_dark_mode</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Text Input Styles - Dark Mode -->
    <style name="TextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_dark_mode</item>
        <item name="hintTextColor">@color/text_secondary_dark</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Toolbar Style - Dark Mode -->
    <style name="ToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary_dark</item>
        <item name="android:background">@color/surface_dark</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Bottom Navigation Style - Dark Mode -->
    <style name="BottomNavigationStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/primary_dark_mode</item>
        <item name="itemTextColor">@color/text_primary_dark</item>
        <item name="android:background">@color/surface_dark</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Dialog Style - Dark Mode -->
    <style name="DialogStyle" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:background">@color/surface_dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonNegative</item>
    </style>

    <style name="DialogButtonPositive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_dark_mode</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogButtonNegative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary_dark</item>
    </style>
</resources>